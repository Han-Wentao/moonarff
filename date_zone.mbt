///|
priv struct DateZone {
  id : String
  raw : Int32?
  dst : Int32?
}

///|
fn date_zone_index(id : String) -> Int32 raise ArffError {
  for i, name in date_zone_rule_ids {
    if name == id {
      return i
    }
  }
  raise Invalid("timezone rule data missing for " + id)
}

///|
fn date_zone_lookup(
  value : Double,
  initial : Int32,
  start : Int32,
  count : Int32,
  events : Array[(Double, Int32, Int32)],
) -> (Int32, Int32) {
  let mut low = start
  let mut high = start + count
  while low < high {
    let mid = low + (high - low) / 2
    if events[mid].0 <= value {
      low = mid + 1
    } else {
      high = mid
    }
  }
  if low == start {
    (initial, 0)
  } else {
    let (_, raw, dst) = events[low - 1]
    (raw, dst)
  }
}

///|
fn date_zone_offset(zone : DateZone, wall_ms : Double) -> Int32 raise ArffError {
  // Numeric fields stamp both offsets and suppress the calendar zone rules.
  if zone.raw is Some(raw) && zone.dst is Some(dst) {
    return raw + dst
  }
  let index = date_zone_index(zone.id)
  let (initial, saving, start, count) = date_zone_rule_meta[index]
  let (raw, dst) = date_zone_lookup(
    wall_ms, initial, start, count, date_zone_rule_events,
  )
  let automatic = zone.dst is None && (date_zone_auto_masks[index] & 2) != 0
  raw +
  (if automatic {
    dst
  } else {
    zone.dst.unwrap_or(if saving == 0 { dst } else { 0 })
  })
}

///|
// Calendar normalizes using UTC rules, then rechecks only supplied fields.
// A named standard/daylight label may stamp DST while leaving raw historical
// offsets automatic. Rejecting every civil gap would incorrectly reject valid
// date-only input and labels with an explicitly selected daylight offset.
fn date_zone_normalized_wall(
  zone : DateZone,
  value : Double,
) -> Double raise ArffError {
  if zone.raw is Some(raw) && zone.dst is Some(dst) {
    return value + (raw + dst).to_double() * 1000.0
  }
  let index = date_zone_index(zone.id)
  let (initial, start, count) = date_zone_utc_meta[index]
  let (raw, dst) = date_zone_lookup(
    value, initial, start, count, date_zone_utc_events,
  )
  value +
  (zone.raw.unwrap_or(raw) + zone.dst.unwrap_or(dst)).to_double() * 1000.0
}

///|
fn date_named_zone(
  id : String,
  column : Int32,
  previous : DateZone,
) -> DateZone raise ArffError {
  let index = date_zone_index(id)
  let (_, saving, _, _) = date_zone_rule_meta[index]
  let automatic = column <= 2 &&
    (date_zone_auto_masks[index] & (1 << column)) != 0
  if automatic || (column >= 3 && saving == 0) {
    // An ambiguous or legacy daylight label leaves timezone historical rules active.
    { id, raw: previous.raw, dst: previous.dst, }
  } else {
    { id, raw: None, dst: Some(if column >= 3 { saving } else { 0 }), }
  }
}

///|
fn date_parse_zone(
  text : String,
  start : Int32,
  field : Char,
  count : Int32,
  previous : DateZone,
) -> (DateZone, Int32) raise ArffError {
  let mut pos = start
  if pos >= text.length() {
    raise Invalid("timezone required")
  }
  if field == 'X' && text[pos] == 90 {
    return ({ id: previous.id, raw: Some(0), dst: Some(0), }, 1)
  }
  let (gmt, gmt_width) = date_name_index(text, pos, ["GMT"])
  if field != 'X' && gmt >= 0 {
    pos += gmt_width
    if pos >= text.length() || (text[pos] != 43 && text[pos] != 45) {
      return ({ id: previous.id, raw: Some(0), dst: Some(0), }, pos - start)
    }
    let sign = if text[pos] == 45 { -1 } else { 1 }
    pos += 1
    let begin = pos
    while pos < text.length() &&
          text[pos] >= 48 &&
          text[pos] <= 57 &&
          pos - begin < 2 {
      pos += 1
    }
    let hour = date_digits(text, begin, pos - begin)
    if pos >= text.length() || text[pos] != 58 {
      raise Invalid("GMT offset requires colon")
    }
    pos += 1
    let minute = date_digits(text, pos, 2)
    pos += 2
    if hour > 23 || minute > 59 {
      raise Invalid("invalid timezone offset")
    }
    return (
      {
        id: previous.id,
        raw: Some(sign * (hour * 60 + minute) * 60),
        dst: Some(0),
      },
      pos - start,
    )
  }
  if field != 'X' {
    let (utc, width) = date_name_index(text, pos, ["UTC"])
    if utc >= 0 {
      return (date_named_zone("UTC", 2, previous), width)
    }
  }
  if text[pos] == 43 || text[pos] == 45 {
    let sign = if text[pos] == 45 { -1 } else { 1 }
    pos += 1
    let hour = date_digits(text, pos, 2)
    pos += 2
    let mut minute = 0
    if field != 'X' || count >= 2 {
      if field == 'X' && count == 3 {
        if pos >= text.length() || text[pos] != 58 {
          raise Invalid("timezone colon required")
        }
        pos += 1
      }
      minute = date_digits(text, pos, 2)
      pos += 2
    }
    if hour > 23 || minute > 59 {
      raise Invalid("invalid timezone offset")
    }
    return (
      {
        id: previous.id,
        raw: Some(sign * (hour * 60 + minute) * 60),
        dst: Some(0),
      },
      pos - start,
    )
  }
  if field != 'X' {
    // SimpleDateFormat prefers the currently selected zone before its global
    // name table: China Standard Time followed by CST must remain Shanghai.
    let index = date_zone_index(previous.id)
    for i, name in date_zone_rule_names[index] {
      let (found, width) = date_name_index(text, pos, [name])
      if found >= 0 {
        return (date_named_zone(previous.id, i + 1, previous), width)
      }
    }
    for (name, _offset, _row, zone_id, column) in date_named_zones {
      let (found, width) = date_name_index(text, pos, [name])
      if found >= 0 {
        return (date_named_zone(zone_id, column, previous), width)
      }
    }
  }
  raise Invalid("unknown English timezone name")
}

///|
fn date_format_zone(zone : Int32, field : Char, count : Int32) -> String {
  if zone == 0 {
    return if field == 'X' {
      "Z"
    } else if field == 'z' {
      "UTC"
    } else {
      "+0000"
    }
  }
  let absolute = if zone < 0 { -zone } else { zone }
  let sign = if zone < 0 { "-" } else { "+" }
  let hour = padded_date(absolute / 60, 2)
  let minute = padded_date(absolute % 60, 2)
  if field == 'z' {
    "GMT" + sign + hour + ":" + minute
  } else if field == 'X' && count == 1 {
    sign + hour
  } else if field == 'X' && count == 3 {
    sign + hour + ":" + minute
  } else {
    sign + hour + minute
  }
}
